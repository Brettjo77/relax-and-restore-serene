---
/**
 * Direction 01 · Serene — "My work" gallery.
 *
 * Lisa's own brow photos. A masonry (CSS columns) layout rather than a uniform
 * grid, because the set mixes square before/after composites with portrait
 * close-ups — cropping to a common aspect ratio would cut the "before" half off
 * the composites, which is the whole point of them.
 *
 * No lightbox / JS: the photos are shown large enough to read as they are.
 */
import { Image } from 'astro:assets';
import { gallery } from '../data/site.js';
import { images, imageAlt } from '../data/images.js';
---
<section class="section work" id="work" aria-labelledby="work-title">
  <div class="section__inner">
    <header class="work__head">
      <p class="eyebrow">My work</p>
      <h2 class="h2" id="work-title">Real results, real clients</h2>
    </header>

    <ul class="work__grid">
      {gallery.map((g, i) => (
        <li class="work__item">
          <figure class="work__fig">
            <Image
              src={images[g.image]}
              alt={imageAlt[g.image]}
              class="work__img"
              widths={[340, 500, 680]}
              {/* Columns are capped by the grid's max-width, so beyond ~1024px the
                  tile stops growing at ~330px — don't keep requesting by vw. */}
              sizes="(max-width: 640px) min(90vw, 26rem), (max-width: 980px) min(45vw, 21rem), 330px"
              loading={i < 2 ? 'eager' : 'lazy'}
            />
            <figcaption class="work__cap">{g.caption}</figcaption>
          </figure>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .work { background: var(--cream-light); }
  .work__head { text-align: center; max-width: 30ch; margin: 0 auto 32px; }

  /* Masonry via CSS columns — packs mixed heights with no cropping. */
  .work__grid {
    list-style: none;
    margin: 0 auto;
    padding: 0;
    max-width: 64rem;
    column-count: 3;
    column-gap: 22px;
  }
  .work__item {
    break-inside: avoid;       /* don't split a photo across columns */
    margin-bottom: 22px;
  }
  .work__fig {
    margin: 0;
    background: #fff;
    border-radius: var(--r-card);
    box-shadow: var(--shadow-card);
    overflow: hidden;
  }
  .work__img {
    display: block;
    width: 100%;
    height: auto;
  }
  .work__cap {
    padding: 13px 16px 15px;
    text-align: center;
    font-size: 13px;
    line-height: 1.45;
    color: var(--muted);
  }

  @media (max-width: 980px) {
    .work__grid { column-count: 2; max-width: 44rem; }
  }
  @media (max-width: 640px) {
    .work__grid { column-count: 1; max-width: 26rem; }
  }

  @media (prefers-reduced-motion: no-preference) {
    .work__fig { transition: transform .3s ease, box-shadow .3s ease; }
    .work__fig:hover { transform: translateY(-3px); box-shadow: var(--shadow-float); }
  }
</style>
